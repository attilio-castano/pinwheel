private def check (ok : Bool) (label : String) : IO Unit :=
  unless ok do throw (IO.userError ("Buffered SRAM fixture: " ++ label))

private def inputIndex : Reactive.Input w → Nat
  | .initialize => 0 | .command => 1 | .address => 2 | .word => 3
  | .control => 4 | .branch => 5 | .count => 6 | .virtualSpan => 7
  | .idleLevels => 8 | .idleEnabled => 9 | .txData => 10 | .txLength => 11
  | .rxCapacity => 12 | .expectedGeneration => 13 | .expectedTransfer => 14
  | .readIndex => 15 | .rawInputs => 16

private def inputSnapshot (j : Lean.Json) : Array Nat :=
  let cmd := (j.getObjVal? "command").toOption.getD (Lean.Json.mkObj [])
  Reactive.inputs.map fun ⟨_,p⟩ =>
    if Reactive.inputLabel p == "raw_inputs" then
      ((j.getObjVal? "raw_inputs").bind Lean.Json.getNat?).toOption.getD 0
    else ((cmd.getObjVal? (Reactive.inputLabel p)).bind Lean.Json.getNat?).toOption.getD 0

private def inputValues (a : Array Nat) : Values Reactive.Input := fun {w} p =>
  BitVec.ofNat w (a[inputIndex p]?.getD 0)

private def sourceInitial (s : SramModel.State) : Values SharedBranches.Register
  | _, .row k => s.registers.values (.metadata k) ++ s.contents 0 k
  | _, .branch k => s.registers.values (.branch k)
  | _, .branchWritten => s.registers.values .branchWritten
  | _, .core r => s.registers.values (.core r)

private structure SourceSnapshot where
  bank : Array Nat
private def SourceSnapshot.values (s : SourceSnapshot) : Values SharedBranches.Register :=
  fun {w} r => BitVec.ofNat w (s.bank[SharedBranches.registerIndex r]?.getD 0)
private def sourceSnapshot (s : Values SharedBranches.Register) : SourceSnapshot :=
  ⟨SharedBranches.registers.map fun ⟨_,r⟩ => (s r).toNat⟩

private def sourceNextExpressions : Array (Sigma (Expr Reactive.Input SharedBranches.Register)) :=
  SharedBranches.registers.map fun ⟨w,r⟩ => ⟨w,SharedBranches.circuit.next r⟩

private def runCase (c : Lean.Json) (seed : Nat) : IO Nat := do
  let name := (c.getObjValAs? String "name").toOption.getD "unnamed"
  let vectors ← IO.ofExcept ((c.getObjVal? "vectors").bind Lean.Json.getArr?)
  let mut s := SramModel.State.initial seed
  let mut old : Values SharedBranches.Register := sourceInitial s
  for edge in [:vectors.size] do
    let inputBank := inputSnapshot vectors[edge]!
    let i : Values Reactive.Input := inputValues inputBank
    let after := s.step i
    let oldSnapshot : SourceSnapshot := ⟨MemoEval.evalMany i old sourceNextExpressions⟩
    if edge < 2 || edge + 2 >= vectors.size then
      check (after.registers.bank == (SramModel.snapshot (Sram.circuit.step (s.inputs i) s.registers.values)).bank)
        "batch actual controller versus ordinary Expr.eval boundary"
      check (oldSnapshot.bank == (sourceSnapshot (SharedBranches.circuit.step i old)).bank)
        "batch predecessor versus ordinary Expr.eval boundary"
    let oldAfter : Values SharedBranches.Register := oldSnapshot.values
    for ⟨_,o⟩ in Reactive.outputs do
      let observed := if Reactive.outputLabel o == "rejected" then s.observe i o else after.observe i o
      let expected := if Reactive.outputLabel o == "rejected" then SharedBranches.circuit.observe i old o
        else SharedBranches.circuit.observe i oldAfter o
      check (observed == expected) s!"{name} seed{seed} edge{edge} {Reactive.outputLabel o}"
    let ci : Values Sram.Input := s.inputs i
    let write := Sram.circuit.observe ci s.registers.values (.port .write)
    let read := Sram.circuit.observe ci s.registers.values (.port .read)
    check (read == ~~~write) "exclusive physical access"
    for b in [false,true] do
      let port : Fin 2 := if b then 1 else 0
      -- The kernel theorem readAddress_postcore identifies the composed request
      -- expression with this candidate on the materialized actual core step.
      -- Re-evaluate the large composed expression at boundary witnesses; every
      -- edge still checks all public fields, writes, Q and live availability.
      let wanted := ((SramCandidates.candidate b).eval i after.core).extractLsb' 0 6
      let address := if write == 1 then i .address else wanted
      if edge < 2 || edge + 2 >= vectors.size then
        check (Sram.circuit.observe ci s.registers.values (.port (.address b)) == address)
          "actual expression boundary request"
      if write == 1 then
        check (address == i .address && after.contents port address == i .word)
          "both actual request ports broadcast write"
        check (after.q[port.val]! == s.q[port.val]!) "write holds Q"
      else
        check (BitVec.ofNat 64 after.q[port.val]! == s.contents port address)
          "actual latency-one request produces Q"
    if after.observe i .valid == 1 && after.observe i .busy == 1 then
      for b in [false,true] do
        let port : Fin 2 := if b then 1 else 0
        let candidate := ((SramCandidates.candidate b).eval i after.core).extractLsb' 0 6
        if candidate.toNat < (after.registers.values (.core .count)).toNat then
          check (BitVec.ofNat 64 after.q[port.val]! == after.contents port candidate)
            "live candidate availability after every edge"
      check (after.registers.values .startWord == (oldAfter (.row 0)).extractLsb' 0 64)
        "resident START mirror"
    s := after
    old := oldAfter
  return vectors.size

def main : IO Unit := do
  for (entry, k) in Reactive.inputs.toList.zipIdx do
    let ⟨_,p⟩ := entry
    check (inputIndex p == k) "input snapshot enumeration"
  let request ← IO.ofExcept (Lean.Json.parse requestText)
  let cases ← IO.ofExcept ((request.getObjVal? "cases").bind Lean.Json.getArr?)
  let mut edges := 0
  for seed in [0,7,12345] do
    for c in cases do edges := edges + (← runCase c seed)
  IO.println s!"Buffered SRAM hardware: {cases.size*3} independently seeded closed-loop cases, {edges} edges; all26 public fields, kernel-identified prospective addresses with ordinary evaluation boundary witnesses, broadcast writes, retained Q, live candidate availability and START mirror passed."
