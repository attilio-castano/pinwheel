import Pinwheel.Program.StreamingSession
import Pinwheel.Program.StreamingReadySafety

/-! Independent simultaneous host/frontend and bounded engine source session.
Physical host samples determine the command; engine status feeds the host's
next state on the same edge, without a combinational command/status cycle. -/
namespace Pinwheel.Program.StreamingReady
open Pinwheel.Program.Streaming

def State.status (s : State a) (pending : Bool) (i : Input) : Host.Status :=
  { valid := true, busy := s.phase.busy, retained := s.phase.retained
    pending := pending
    rejected :=
      (i.command != 0 && !((i.command == 3 && s.canStart i) ||
        (i.command == 4 && s.canRelease i))) ||
      (i.txPush && !s.tx.willPush (s.hostPush i)) ||
      (i.rxPop && !s.rx.willPop (s.hostPop i))
    stalled := (s.phase == .boundary && !s.canReserve) || (s.phase == .waiting && !s.waitReady)
    fault := s.phase == .fault
    waitingTX := s.phase == .boundary && s.current.isStream &&
      s.current.cell.transmit && !(s.txValid != 0 || s.tx.readable)
    waitingRX := s.phase == .boundary && s.current.isStream &&
      s.current.cell.receive && !s.rx.writable
    generation := s.generation, transfer := s.transfer
    phase := s.phase.code, pc := s.pc, remaining := s.remaining, total := s.total
    levels := s.pins.levels, enabled := s.pins.enabled
    txFree := BitVec.ofNat 4 (queueDepth a) - BitVec.ofNat 4 s.tx.count.val
    txQueued := BitVec.ofNat 4 s.tx.count.val
    rxQueued := BitVec.ofNat 4 s.rx.count.val
    rxData := if s.rx.readable then s.rx.peek.data else 0
    rxBits := if s.rx.readable then BitVec.ofNat 6 s.rx.peek.validBits else 0
    txAccepted := s.txAccepted, txConsumed := s.txConsumed
    rxProduced := s.rxProduced, rxPopped := s.rxPopped
    stage1 := s.samplerFirst, stage2 := s.samplerSecond }

namespace Session

abbrev Pins := Streaming.Session.Pins

def Pins.host (i : Pins) (status : Host.Status) : Host.Input := Streaming.Session.Pins.host i status

structure State (a : Nat) where
  host : Host.State := {}
  core : StreamingReady.State a := {}
  deriving DecidableEq, Repr

def State.command (s : State a) (i : Pins) : Host.Command := s.host.command (i.host {})

theorem command_status_independent (s : Host.State) (i : Pins) (left right : Host.Status) :
    s.command (i.host left) = s.command (i.host right) := rfl

def State.hostInput (s : State a) (pending : Bool) (i : Pins) : Host.Input :=
  i.host (s.core.status pending (s.command i).runtime)

def State.step (s : State a) (p : Program) (pending : Bool) (i : Pins) : State a :=
  ⟨Host.step (s.hostInput pending i) s.host, StreamingReady.step p (s.command i).runtime s.core⟩

def State.run (s : State a) (p : Program) (pending : Bool) (inputs : List Pins) : State a :=
  inputs.foldl (fun s i => s.step p pending i) s

def RuntimeInput (s : State a) (i : Pins) : Prop :=
  (s.command i).runtime.initialize = false ∧ (s.command i).runtime.command ≠ 15 ∧
    (s.command i).runtime.command ≠ 1 ∧ (s.command i).runtime.command ≠ 2

/-- A source command grammar, not an assumed execution-agreement relation. -/
def RuntimeTrace (p : Program) (pending : Bool) : State a → List Pins → Prop
  | _, [] => True
  | s, i::rest => RuntimeInput s i ∧ RuntimeTrace p pending (s.step p pending i) rest

/-- The exact engine command history generated by the feedback session. -/
def State.runtimeInputs (s : State a) (p : Program) (pending : Bool) : List Pins → List StreamingReady.Input
  | [] => []
  | i::rest => (s.command i).runtime :: (s.step p pending i).runtimeInputs p pending rest

theorem State.run_core (s : State a) (p : Program) (pending : Bool) (samples : List Pins) :
    (s.run p pending samples).core =
      StreamingReady.run p s.core (s.runtimeInputs p pending samples) := by
  induction samples generalizing s with
  | nil => rfl
  | cons i rest ih =>
    change ((s.step p pending i).run p pending rest).core =
      StreamingReady.run p (StreamingReady.step p (s.command i).runtime s.core)
        ((s.step p pending i).runtimeInputs p pending rest)
    exact ih _

theorem RuntimeTrace.runtimeInputs (p : Program) (pending : Bool) (s : State a) (samples : List Pins)
    (runtime : RuntimeTrace p pending s samples) :
    ∀ i ∈ s.runtimeInputs p pending samples, i.Runtime := by
  induction samples generalizing s with
  | nil => simp [State.runtimeInputs]
  | cons i rest ih =>
    intro sample member
    simp only [State.runtimeInputs,List.mem_cons] at member
    rcases member with same | later
    · subst sample
      exact ⟨runtime.1.1,runtime.1.2.1⟩
    · exact ih (s.step p pending i) runtime.2 sample later

theorem State.step_structural (s : State a) (p : Program) (pending : Bool) (i : Pins)
    (hs : s.core.Structural) : (s.step p pending i).core.Structural :=
  StreamingReady.step_structural p s.core (s.command i).runtime hs

theorem State.run_structural (s : State a) (p : Program) (pending : Bool) (samples : List Pins)
    (hs : s.core.Structural) : (s.run p pending samples).core.Structural := by
  induction samples generalizing s with
  | nil => exact hs
  | cons i rest ih => exact ih (s.step p pending i) (s.step_structural p pending i hs)

end Session
end Pinwheel.Program.StreamingReady
