theorem late_reservationMiss : firstReservationMiss late 1 = .ok (some 64) := by decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 20000000 in
theorem late_noCreditAtMiss :
    let s := (bodyAt late 1 (reservationCut 64)).core
    s.phase = .boundary ∧ s.txConsumed = 64 ∧ s.canReserve = false := by decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 20000000 in
/-- The late session completes after the PHY frame window. It still settles
every bit and the ordinary host release returns the engine to free. -/
theorem late_settles :
    let settled := (complete late 1).run program false ((releaseClocked 1).take 6)
    settled.core.phase = .completed ∧ settled.core.txAccepted = 576 ∧
      settled.core.txConsumed = 576 ∧ settled.core.drained = true ∧
      (released late 1).core.phase = .free ∧ (released late 1).host.code = 0 := by
  decide +kernel

