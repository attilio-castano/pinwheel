import Pinwheel.Program.StreamingReadySession
import Pinwheel.Program.StreamingReadyEventualService

/-! Progress uses the commands actually generated by the sampled feedback
session. Host credits and unbounded peer waits have separate fairness premises. -/
namespace Pinwheel.Program.StreamingReady.SessionService
open Pinwheel.Program.StreamingReady

def clocks (incoming : Nat → Session.Pins) (edges : Nat) : List Session.Pins :=
  (List.range edges).map incoming

def state (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) : Nat → Session.State a
  | 0 => initial
  | n+1 => (state p pending initial incoming n).step p pending (incoming n)

def coreInputs (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (n : Nat) : Input :=
  (state p pending initial incoming n).command (incoming n) |>.runtime

theorem core_state (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (n : Nat) :
    (state p pending initial incoming n).core =
      EventualService.state p initial.core (coreInputs p pending initial incoming) n := by
  induction n with
  | zero => rfl
  | succ n induction =>
    change step p (coreInputs p pending initial incoming n)
      (state p pending initial incoming n).core = _
    rw [induction]
    rfl

theorem state_eq_run (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (edges : Nat) :
    state p pending initial incoming edges = initial.run p pending (clocks incoming edges) := by
  induction edges with
  | zero => rfl
  | succ edges induction =>
    simp [state,clocks,List.range_succ,Session.State.run,List.foldl_append,induction]

def Runtime (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) : Prop :=
  ∀ n, Session.RuntimeInput (state p pending initial incoming n) (incoming n)

theorem runtimeTrace_append (p : Program) (pending : Bool) (initial : Session.State a)
    (before after : List Session.Pins) :
    Session.RuntimeTrace p pending initial (before ++ after) ↔
      Session.RuntimeTrace p pending initial before ∧
        Session.RuntimeTrace p pending (initial.run p pending before) after := by
  induction before generalizing initial with
  | nil => simp [Session.RuntimeTrace,Session.State.run]
  | cons pin rest induction =>
    change (_ ∧ Session.RuntimeTrace p pending (initial.step p pending pin) (rest ++ after)) ↔
      (_ ∧ Session.RuntimeTrace p pending (initial.step p pending pin) rest) ∧
        Session.RuntimeTrace p pending ((initial.step p pending pin).run p pending rest) after
    rw [induction]
    exact and_assoc.symm

theorem Runtime.runtimeTrace (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (runtime : Runtime p pending initial incoming) (edges : Nat) :
    Session.RuntimeTrace p pending initial (clocks incoming edges) := by
  induction edges with
  | zero => trivial
  | succ edges induction =>
    have last : Session.RuntimeInput (initial.run p pending (clocks incoming edges)) (incoming edges) := by
      rw [← state_eq_run]
      exact runtime edges
    change Session.RuntimeTrace p pending initial (((List.range (edges+1)).map incoming))
    rw [List.range_succ,List.map_append]
    exact (runtimeTrace_append p pending initial _ _).mpr ⟨induction,last,trivial⟩

structure Fair (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) : Prop where
  credits : ∀ n, (state p pending initial incoming n).core.phase = .boundary →
    ∃ m, n ≤ m ∧ (state p pending initial incoming m).core.canReserve = true
  guards : ∀ n, (state p pending initial incoming n).core.phase = .waiting →
    (state p pending initial incoming n).core.current.guard.limit = .unbounded →
    ∃ m, n ≤ m ∧ (state p pending initial incoming m).core.waitReady = true

theorem Runtime.core_runtime (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (runtime : Runtime p pending initial incoming) (n : Nat) :
    (coreInputs p pending initial incoming n).Runtime :=
  ⟨(runtime n).1,(runtime n).2.1⟩

theorem Fair.core_fair (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (fair : Fair p pending initial incoming) :
    EventualService.Fair p initial.core (coreInputs p pending initial incoming) := by
  constructor
  · intro n boundary
    have boundary' : (state p pending initial incoming n).core.phase = .boundary := by
      rw [core_state]; exact boundary
    obtain ⟨m,later,ready⟩ := fair.credits n boundary'
    exact ⟨m,later,by rw [← core_state]; exact ready⟩
  · intro n waiting unbounded
    have waiting' : (state p pending initial incoming n).core.phase = .waiting := by
      rw [core_state]; exact waiting
    have unbounded' : (state p pending initial incoming n).core.current.guard.limit = .unbounded := by
      rw [core_state]; exact unbounded
    obtain ⟨m,later,ready⟩ := fair.guards n waiting' unbounded'
    exact ⟨m,later,by rw [← core_state]; exact ready⟩

/-- A retained success or fault occurs after a finite number of actual physical
session clocks. Fairness allows every finite host or peer stall. -/
theorem admitted_start (p : Program) (pending : Bool) (before : Session.State a)
    (startPin : Session.Pins) (incoming : Nat → Session.Pins)
    (startRuntime : Session.RuntimeInput before startPin)
    (admitted : ((before.command startPin).runtime.command == 3 &&
      before.core.canStart (before.command startPin).runtime) = true)
    (runtime : Runtime p pending (before.step p pending startPin) incoming)
    (fair : Fair p pending (before.step p pending startPin) incoming) :
    ∃ edges, ((before.step p pending startPin).run p pending (clocks incoming edges)).core.phase.retained = true := by
  have reached := EventualService.admitted_start p before.core (before.command startPin).runtime
    (coreInputs p pending (before.step p pending startPin) incoming)
    ⟨startRuntime.1,startRuntime.2.1⟩ admitted
    (Runtime.core_runtime p pending _ incoming runtime) (Fair.core_fair p pending _ incoming fair)
  obtain ⟨edges,retained⟩ := reached
  refine ⟨edges,?_⟩
  rw [← state_eq_run,core_state,EventualService.state_eq_run]
  exact retained

end Pinwheel.Program.StreamingReady.SessionService
