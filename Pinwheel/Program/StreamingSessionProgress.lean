import Pinwheel.Program.StreamingEventualService
import Pinwheel.Program.StreamingSession

/-! Liveness of the actual feedback-generated joint source session. -/
namespace Pinwheel.Program.Streaming.SessionProgress

def clocks (incoming : Nat → Session.Pins) (edges : Nat) : List Session.Pins :=
  (List.range edges).map incoming

def state (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) : Nat → Session.State a
  | 0 => initial
  | n+1 => (state p pending initial incoming n).step p pending (incoming n)

def coreIncoming (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (n : Nat) : Input :=
  ((state p pending initial incoming n).command (incoming n)).runtime

def Runtime (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) : Prop :=
  ∀ n, Session.RuntimeInput (state p pending initial incoming n) (incoming n)

def Fair (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) : Prop :=
  ∀ n, (state p pending initial incoming n).core.phase = .boundary →
    ∃ m, n ≤ m ∧ (state p pending initial incoming m).core.canReserve = true

theorem state_eq_run (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (edges : Nat) :
    state p pending initial incoming edges = initial.run p pending (clocks incoming edges) := by
  induction edges with
  | zero => rfl
  | succ edges induction =>
    simp [state,clocks,List.range_succ,Session.State.run,List.foldl_append,induction]

theorem core_state (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (edges : Nat) :
    (state p pending initial incoming edges).core =
      EventualService.state p initial.core (coreIncoming p pending initial incoming) edges := by
  induction edges with
  | zero => rfl
  | succ edges induction =>
    exact congrArg (Streaming.step p (coreIncoming p pending initial incoming edges)) induction

theorem runtime_snoc (p : Program) (pending : Bool) (initial : Session.State a)
    (earlier : List Session.Pins) (last : Session.Pins)
    (runtime : Session.RuntimeTrace p pending initial earlier)
    (lastRuntime : Session.RuntimeInput (initial.run p pending earlier) last) :
    Session.RuntimeTrace p pending initial (earlier ++ [last]) := by
  induction earlier generalizing initial with
  | nil => exact ⟨lastRuntime, trivial⟩
  | cons i earlier induction =>
    exact ⟨runtime.1, induction (initial.step p pending i) runtime.2 lastRuntime⟩

theorem runtime_prefix (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (runtime : Runtime p pending initial incoming) (edges : Nat) :
    Session.RuntimeTrace p pending initial (clocks incoming edges) := by
  induction edges with
  | zero => trivial
  | succ edges induction =>
    have lastRuntime := runtime edges
    rw [state_eq_run p pending initial incoming edges] at lastRuntime
    simpa only [clocks,List.range_succ,List.map_append,List.map_singleton] using
      runtime_snoc p pending initial (clocks incoming edges) (incoming edges) induction lastRuntime

theorem reaches_retained (p : Program) (pending : Bool) (initial : Session.State a)
    (incoming : Nat → Session.Pins) (runtime : Runtime p pending initial incoming)
    (fair : Fair p pending initial incoming) (initialProgress : initial.core.Progress)
    (initialCursor : initial.core.Cursor) (initialBusy : initial.core.phase.busy = true) :
    ∃ edges, Session.RuntimeTrace p pending initial (clocks incoming edges) ∧
      (initial.run p pending (clocks incoming edges)).core.phase.retained = true := by
  have coreRuntime : ∀ n, (coreIncoming p pending initial incoming n).Runtime :=
    fun n => ⟨(runtime n).1, (runtime n).2.1⟩
  have coreFair : EventualService.Fair p initial.core (coreIncoming p pending initial incoming) := by
    intro n boundary
    rw [← core_state p pending initial incoming n] at boundary
    obtain ⟨m,later,ready⟩ := fair n boundary
    exact ⟨m,later,by rw [← core_state p pending initial incoming m]; exact ready⟩
  obtain ⟨edges,retained⟩ := EventualService.reaches_retained p initial.core
    (coreIncoming p pending initial incoming) coreRuntime initialProgress initialCursor initialBusy coreFair
  rw [← core_state p pending initial incoming edges,state_eq_run p pending initial incoming edges] at retained
  exact ⟨edges,runtime_prefix p pending initial incoming runtime edges,retained⟩

/-- Service and commands are generated by the reached joint session itself.
An admitted START establishes the progress bounds without a supplied invariant. -/
theorem admitted_start (p : Program) (pending : Bool) (before : Session.State a)
    (start : Session.Pins) (incoming : Nat → Session.Pins)
    (startRuntime : Session.RuntimeInput before start)
    (admitted : ((before.command start).runtime.command == 3 &&
      before.core.canStart (before.command start).runtime) = true)
    (runtime : Runtime p pending (before.step p pending start) incoming)
    (fair : Fair p pending (before.step p pending start) incoming) :
    ∃ edges, Session.RuntimeTrace p pending (before.step p pending start) (clocks incoming edges) ∧
      ((before.step p pending start).run p pending (clocks incoming edges)).core.phase.retained = true := by
  have core : (before.step p pending start).core =
      before.core.start p (before.command start).runtime := by
    change Streaming.step p (before.command start).runtime before.core = _
    simp only [Bool.and_eq_true,beq_iff_eq] at admitted
    simp [Streaming.step,startRuntime.1,admitted.1,admitted.2]
  have initialProgress : (before.step p pending start).core.Progress := by
    rw [core]
    exact before.core.start_progress p (before.command start).runtime
  have initialCursor : (before.step p pending start).core.Cursor := by
    rw [core]
    constructor <;> simp [State.start,Phase.activeCell]
  exact reaches_retained p pending (before.step p pending start) incoming runtime fair
    initialProgress initialCursor (by rw [core]; rfl)

end Pinwheel.Program.Streaming.SessionProgress
